# Generated by tools/build-arch.py from the current source snapshots.
pkgname=freeallegiance-native
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Allegiance native Vulkan client, game server and public directory'
arch=('x86_64')
url='https://github.com/FreeAllegiance/Allegiance'
license=('MIT' 'BSD-3-Clause')
depends=(
  'glibc' 'libgcc' 'libstdc++' 'ffmpeg' 'fontconfig' 'freetype2' 'liburing' 'lz4'
  'openal' 'openssl' 'protobuf' 'sdl3' 'vulkan-icd-loader' 'vulkan-driver'
  'libavformat.so' 'libavcodec.so' 'libavutil.so' 'libswscale.so'
  'libswresample.so' 'libprotobuf.so'
)
makedepends=('clang' 'lld' 'cmake' 'ninja' 'glm' 'shaderc' 'pkgconf' 'python')
optdepends=('ttf-dejavu: fallback font when Verdana is unavailable')
# CMake controls ThinLTO; makepkg's additional GCC-style LTO flags conflict.
options=('!lto' '!debug')
source=('freeallegiance-source.tar.gz' 'GameNetworkingSockets-source.tar.gz' 'source-snapshot.json')
sha256sums=('@ALLEGIANCE_SHA256@' '@GNS_SHA256@' '@SNAPSHOT_SHA256@')

build() {
  cmake -S "$srcdir/freeallegiance" -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_C_FLAGS_RELEASE='-O3 -DNDEBUG' \
    -DCMAKE_CXX_FLAGS_RELEASE='-O3 -DNDEBUG -ffp-contract=off' \
    -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS -fuse-ld=lld" \
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON \
    -DCMAKE_SKIP_RPATH=ON -DCMAKE_INSTALL_PREFIX=/usr \
    -DALLEGIANCE_NATIVE_CLIENT=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_GameNetworkingSockets=ON \
    -DFETCHCONTENT_SOURCE_DIR_GNS="$srcdir/GameNetworkingSockets" \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DBUILD_STATIC_LIB=ON -DBUILD_SHARED_LIB=OFF \
    -DUSE_CRYPTO=OpenSSL -DUSE_IO_URING=ON -DUSE_STEAMWEBRTC=OFF \
    -DBUILD_EXAMPLES=OFF -DBUILD_TESTS=OFF -DBUILD_TOOLS=OFF
  cmake --build "$srcdir/build" --target \
    allegiance-native allegiance-server allegiance-directory \
    allegiance-affinity-check allegiance-frustum-check \
    allegiance-presentation-check allegiance-network-arena-check
}

check() {
  ctest --test-dir "$srcdir/build" --output-on-failure \
    -R '^native-(affinity|frustum|presentation|network-arenas)$'
  for program in allegiance-native allegiance-server allegiance-directory; do
    "$srcdir/build/src/native/$program" --help > /dev/null
  done
}

package() {
  # Install release artifacts only: GNS is statically linked. Do not install
  # its development headers, static archives, or the diagnostic programs.
  for program in allegiance-native allegiance-server allegiance-directory; do
    install -Dm755 "$srcdir/build/src/native/$program" "$pkgdir/usr/bin/$program"
  done
  install -Dm644 "$srcdir/build/src/native/shaders/"*.spv \
    -t "$pkgdir/usr/share/freeallegiance/shaders/"
  install -Dm644 "$srcdir/freeallegiance/src/native/org.freeallegiance.Native.desktop" \
    -t "$pkgdir/usr/share/applications/"
  install -Dm644 "$srcdir/freeallegiance/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/GameNetworkingSockets/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/GameNetworkingSockets.txt"
  install -Dm644 "$srcdir/freeallegiance/src/Lib/nlohmann/json/LICENSE.MIT.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/nlohmann-json.txt"
  install -Dm644 "$srcdir/freeallegiance/docs/native-arch.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  python - "$srcdir" "$pkgdir" <<'PY'
import json
from pathlib import Path
import re
import sys

source, package = map(Path, sys.argv[1:])
identity = re.search(r'"([0-9a-f]{64})"',
                     (source / 'build/src/native/network_build.hpp').read_text())[1]
metadata = {
    'platform': 'linux-x86_64',
    'network_build': identity,
    'steam_assets_included': False,
    'source_snapshot': json.loads((source / 'source-snapshot.json').read_text()),
}
(package / 'usr/share/freeallegiance/build-info.json').write_text(
    json.dumps(metadata, indent=2) + '\n')
PY
}
