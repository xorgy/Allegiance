# Linux-hosted LLVM cross compiler using an SDK and libraries from a Mac.
set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "Mac architecture")
set(CMAKE_OSX_DEPLOYMENT_TARGET 26.0 CACHE STRING "Minimum macOS version")
if(DEFINED ENV{MACOS_SDK})
    set(CMAKE_OSX_SYSROOT "$ENV{MACOS_SDK}" CACHE PATH "macOS SDK")
endif()
if(NOT EXISTS "${CMAKE_OSX_SYSROOT}/usr/include")
    message(FATAL_ERROR "Set MACOS_SDK to a macOS 26 or newer SDK; see tools/build-macos.sh")
endif()
set(MACOS_DEPS_PREFIX "$ENV{MACOS_DEPS_PREFIX}" CACHE PATH "Staged Mac dependencies")
find_program(_macos_clang clang REQUIRED NO_CMAKE_FIND_ROOT_PATH)
find_program(_macos_clangxx clang++ REQUIRED NO_CMAKE_FIND_ROOT_PATH)
set(CMAKE_C_COMPILER "${_macos_clang}")
set(CMAKE_CXX_COMPILER "${_macos_clangxx}")
set(CMAKE_OBJCXX_COMPILER "${_macos_clangxx}")
set(CMAKE_C_COMPILER_TARGET arm64-apple-macos26.0)
set(CMAKE_CXX_COMPILER_TARGET arm64-apple-macos26.0)
set(CMAKE_OBJCXX_COMPILER_TARGET arm64-apple-macos26.0)
set(CMAKE_AR llvm-ar)
set(CMAKE_RANLIB llvm-ranlib)
set(CMAKE_LINKER ld64.lld)
set(CMAKE_INSTALL_NAME_TOOL llvm-install-name-tool)
# Besides removing unused code/dependencies, dead_strip prevents empty LLVM
# input sections from masking valid compact-unwind entries in ld64.lld.
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -Wl,-dead_strip,-dead_strip_dylibs")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")
get_filename_component(_macos_cache "${MACOS_DEPS_PREFIX}" DIRECTORY)
set(CMAKE_FIND_ROOT_PATH "${_macos_cache}/ffmpeg" "${MACOS_DEPS_PREFIX}" "${CMAKE_OSX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
