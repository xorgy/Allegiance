# clang-cl + the MSVC SDK and CRT cached by cargo-xwin. Set XWIN_ROOT to
# the directory containing crt/ and sdk/ to use a different SDK installation.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(DEFINED ENV{XWIN_ROOT})
    set(XWIN_ROOT "$ENV{XWIN_ROOT}")
else()
    set(XWIN_ROOT "$ENV{HOME}/.cache/cargo-xwin/xwin")
endif()
if(NOT EXISTS "${XWIN_ROOT}/crt/include")
    message(FATAL_ERROR "Missing xwin SDK: run cargo xwin env --target x86_64-pc-windows-msvc, or set XWIN_ROOT")
endif()
set(CMAKE_C_COMPILER clang-cl)
set(CMAKE_CXX_COMPILER clang-cl)
set(CMAKE_AR llvm-lib)
set(CMAKE_LINKER lld-link)
set(CMAKE_RC_COMPILER llvm-rc)
set(CMAKE_MT llvm-mt)
set(CMAKE_CROSSCOMPILING_EMULATOR wine)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
set(_xwin_flags "--target=x86_64-pc-windows-msvc -Wno-unused-command-line-argument")
foreach(_include crt/include sdk/include/ucrt sdk/include/um sdk/include/shared sdk/include/winrt)
    string(APPEND _xwin_flags " /imsvc\"${XWIN_ROOT}/${_include}\"")
endforeach()
set(CMAKE_C_FLAGS_INIT "${_xwin_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_xwin_flags} /EHsc")
set(CMAKE_RC_FLAGS_INIT "/I\"${XWIN_ROOT}/sdk/include/um\" /I\"${XWIN_ROOT}/sdk/include/shared\" /I\"${XWIN_ROOT}/sdk/include/ucrt\"")
set(_xwin_link "/manifest:no")
foreach(_lib crt/lib/x86_64 sdk/lib/um/x86_64 sdk/lib/ucrt/x86_64)
    string(APPEND _xwin_link " /libpath:\"${XWIN_ROOT}/${_lib}\"")
    list(APPEND CMAKE_LIBRARY_PATH "${XWIN_ROOT}/${_lib}")
endforeach()
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_xwin_link}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_xwin_link}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_xwin_link}")
# SDK libraries also make dependency feature probes equivalent to a Windows
# host build. xwin supplies case-correct aliases for these standard names.
set(CMAKE_C_STANDARD_LIBRARIES "kernel32.lib user32.lib gdi32.lib winspool.lib shell32.lib ole32.lib oleaut32.lib uuid.lib comdlg32.lib advapi32.lib" CACHE STRING "" FORCE)
set(CMAKE_CXX_STANDARD_LIBRARIES "${CMAKE_C_STANDARD_LIBRARIES}" CACHE STRING "" FORCE)
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
